[Unit]
Description=Pocket Family — your household organised on your own server
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-family
Group=pocket-family
ExecStart=/usr/local/bin/pocket-family
Environment=DATA_DIR=/var/lib/pocket-family
Environment=PORT=8080
Environment=BASE_URL=https://family.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-family
PrivateTmp=true

[Install]
WantedBy=multi-user.target
